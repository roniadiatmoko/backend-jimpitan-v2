# ==============================================================
# JIMPITAN V2 - BACKEND ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================
# Salin file ini menjadi `.env` lalu sesuaikan isinya dengan kredensial Anda.
# PENTING: JANGAN PERNAH commit file `.env` asli ke GitHub!
# ==============================================================

# Port server backend (default: 3000)
PORT=3000

# Lingkungan aplikasi ('dev' atau 'production')
ENV=production

# Kunci rahasia untuk sesi express
SESSION_SECRET=kunci_rahasia_acak_minimal_32_karakter_anda

# ==============================================================
# WHATSAPP BOT (BAILEYS)
# ==============================================================
# ID Grup WhatsApp tempat laporan jimpitan & tagihan dikirim otomatis.
# Format ID grup WA biasanya diakhiri dengan @g.us
GROUP_ID=120363012345678901@g.us

# ID Grup WA alternatif / grup testing pengurus (opsional)
GROUP_ID_TESTING=120363098765432109@g.us

# ==============================================================
# TELEGRAM BOT (NOTIFIKASI / MONITORING)
# ==============================================================
# Token Bot Telegram dari @BotFather
TELEGRAM_BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ_Contoh

# Chat ID Telegram tujuan notifikasi (pribadi atau ID grup telegram)
ID_TELEGRAM=-1001234567890

# ==============================================================
# POSTGRESQL MIRROR / SUPABASE CLOUD SYNC
# ==============================================================
# Aktifkan pencerminan data otomatis ke PostgreSQL cloud ('true' atau 'false')
ENABLE_PG_MIRROR=true

# Alamat host PostgreSQL (misal: db.abcdefghijkl.supabase.co atau aws-0-ap-southeast-1.pooler.supabase.com)
PGHOST=db.xxxxxxxxxxxx.supabase.co

# Port database (default PostgreSQL: 5432 atau 6543 untuk pooler)
PGPORT=5432

# Nama pengguna database (misal: postgres)
PGUSER=postgres

# Kata sandi database
PGPASSWORD=password_database_anda

# Nama database (biasanya 'postgres')
PGDATABASE=postgres

# Penggunaan SSL ('true' jika memakai Supabase / cloud)
PGSSL=true

# ==============================================================
# GOOGLE GEMINI AI ASSISTANT
# ==============================================================
# API Key Gemini dari Google AI Studio (https://aistudio.google.com/)
GEMINI_API_KEY=AIzaSyD-ContohDummyApiKeyGeminiAnda12345

# Model Gemini yang digunakan
GEMINI_MODEL=gemini-2.5-flash

# ==============================================================
# OTORISASI & KEAMANAN
# ==============================================================
# Nomor WhatsApp Admin Pengurus & Keluarga
ADMIN_PHONE_NUMBER=6289600000000
FAMILY_PHONE_IBU=6285800000000

# PIN Keamanan Keuangan Rumah Tangga (pisahkan koma)
KEUANGAN_RUMAH_PINS=1234,5678

# Token Cloudflare Tunnel (opsional untuk instalasi Linux)
CLOUDFLARE_TUNNEL_TOKEN=token_cloudflare_tunnel_anda

# Secret key API untuk verifikasi request modifikasi data dari frontend
API_SECRET_KEY=rahasiakita123

# Akun Admin Web Pengurus (format: username:password:fullname, pisahkan koma)
ADMIN_USERS=admin:passwordadmin:Administrator
